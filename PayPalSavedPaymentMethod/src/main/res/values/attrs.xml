<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      XML attrs for PayPalSavedPaymentMethodView. Mirrors PayPalSavedPaymentMethodViewStyle's
      field names/semantics 1:1; see that class's KDoc for what each value controls and its
      SDK-provided default when unset.

      Precedence: these attrs establish the view's initial style at construction time. A later
      programmatic setStyle() call fully replaces it, attrs included.
    -->
    <declare-styleable name="PayPalSavedPaymentMethodView">
        <attr name="showLogo" format="boolean" />
        <attr name="showLabel" format="boolean" />
        <attr name="showCreditMessaging" format="boolean" />

        <attr name="componentBackgroundColor" format="color" />
        <attr name="componentTextColor" format="color" />
        <attr name="componentBaseFontSizeSp" format="dimension" />
        <attr name="componentFontResId" format="reference" />

        <attr name="containerHeightDp" format="dimension" />
        <attr name="containerHorizontalPaddingDp" format="dimension" />
        <attr name="containerVerticalPaddingDp" format="dimension" />
        <attr name="containerCornerRadiusDp" format="dimension" />
        <attr name="containerBorderColor" format="color" />
        <attr name="containerBorderWidthDp" format="dimension" />

        <attr name="logoWidthDp" format="dimension" />

        <attr name="labelFontSizeSp" format="dimension" />
        <attr name="labelMarginStartDp" format="dimension" />

        <attr name="fundingInstrumentTextFontSizeSp" format="dimension" />
        <attr name="fundingInstrumentEditIconSizeDp" format="dimension" />
        <attr name="fundingInstrumentMarginStartDp" format="dimension" />

        <attr name="creditMessagingFontSizeSp" format="dimension" />
        <attr name="creditMessagingLinkColor" format="color" />
    </declare-styleable>
</resources>
